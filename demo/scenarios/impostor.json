{
  "id": "impostor",
  "story": "A stranger can't get information by calling back with the wrong code (fast).",
  "speed": "fast",
  "windows": [
    "teller",
    "phone"
  ],
  "steps": [
    {
      "caption": "A scam call, as before: the bank has paused the transfer and messaged the daughter.",
      "do": [
        {
          "a": "goto",
          "path": "/teller"
        },
        {
          "a": "goto",
          "path": "/phone",
          "win": "phone"
        },
        {
          "a": "wait",
          "target": "[data-testid=case-list]"
        }
      ]
    },
    {
      "caption": "The teller keys in the transfer.",
      "do": [
        {
          "a": "openTransfer"
        }
      ],
      "hold": 1500
    },
    {
      "caption": "Submit. The bank checks the payee first.",
      "do": [
        {
          "a": "transfer",
          "expect": "case"
        }
      ],
      "hold": 0
    },
    {
      "caption": "New account, 7 payers: alert.",
      "do": [
        {
          "a": "caseFromUrl"
        }
      ],
      "hold": 1000
    },
    {
      "caption": "Elevated.",
      "do": [
        {
          "a": "wait",
          "target": "[data-testid=risk-banner][data-level=elevated]",
          "thinking": true
        }
      ],
      "hold": 4000
    },
    {
      "caption": "The teller asks the approved question.",
      "do": [
        {
          "a": "click",
          "target": "button:Say this"
        },
        {
          "a": "click",
          "target": "[data-testid=turn-panel] button[type=submit]"
        }
      ],
      "hold": 1500
    },
    {
      "caption": "The customer says it's a renovation.",
      "do": [
        {
          "a": "turn",
          "who": "customer",
          "text": "リフォーム代なんです"
        },
        {
          "a": "wait",
          "target": "[data-testid=why] .quote",
          "text": "リフォーム",
          "thinking": true
        },
        {
          "a": "scroll",
          "target": "[data-testid=why]"
        }
      ]
    },
    {
      "caption": "Then: a police call and secrecy.",
      "do": [
        {
          "a": "turn",
          "who": "customer",
          "text": "警察の人から電話があってね、誰にも言うなって言われてるの"
        },
        {
          "a": "wait",
          "target": "[data-testid=risk-banner][data-level=high]",
          "thinking": true
        }
      ]
    },
    {
      "caption": "High: pause recommended.",
      "do": [
        {
          "a": "scroll",
          "target": "[data-testid=hold-line]"
        }
      ],
      "hold": 5000
    },
    {
      "caption": "The teller chooses the basis and a reason.",
      "do": [
        {
          "a": "select",
          "target": "select[aria-label=Basis]",
          "value": "advance_wishes"
        },
        {
          "a": "type",
          "target": "textarea[aria-label=Rationale]",
          "text": "Police impersonation and secrecy; customer's advance wishes ask for a wait."
        }
      ],
      "hold": 1200
    },
    {
      "caption": "Paused.",
      "do": [
        {
          "a": "click",
          "target": "button:Place pause"
        },
        {
          "a": "wait",
          "target": "[data-testid=risk-banner] .band-state",
          "text": "/paused/i"
        }
      ]
    },
    {
      "caption": "A message goes to the daughter.",
      "do": [
        {
          "a": "click",
          "target": "[data-testid=family-call] summary"
        },
        {
          "a": "wait",
          "target": "[data-testid=family-call]",
          "text": "Notice sent"
        }
      ]
    },
    {
      "caption": {
        "phone": "A stranger gets hold of the message. They call the bank's number and press 1…"
      },
      "do": [
        {
          "a": "phoneNotice",
          "win": "phone",
          "consoleCode": true
        }
      ],
      "hold": 1500
    },
    {
      "caption": {
        "phone": "…but they guess the code: 1111."
      },
      "do": [
        {
          "a": "phoneDial",
          "win": "phone",
          "code": "1111"
        }
      ],
      "hold": 1000
    },
    {
      "caption": {
        "phone": "The call ends. Nothing is said about the customer, the money or the case. A wrong number and a wrong code look the same."
      },
      "do": [
        {
          "a": "wait",
          "win": "phone",
          "target": "[data-testid=phone-verify-failed]"
        },
        {
          "a": "wait",
          "win": "phone",
          "target": "[data-testid=phone-ended]"
        }
      ],
      "hold": 4000
    },
    {
      "caption": "At the counter the teller sees the failed check: nothing was disclosed.",
      "do": [
        {
          "a": "hold",
          "ms": 300
        },
        {
          "a": "wait",
          "target": "[data-testid=verification-failed]"
        },
        {
          "a": "scroll",
          "target": "[data-testid=verification-failed]"
        }
      ],
      "hold": 5000
    }
  ]
}
