<mxfile host="drawio">
  <diagram id="offline" name="Offline jobs">
    <mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Mimamori containers: offline jobs and the analyst (as built)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="800" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="analyst" value="&lt;b&gt;Fraud analyst&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Approves playbooks, decides freezes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gcp" value="Mimamori · bank Google Cloud project (asia-south1) · Cloud Run services and jobs" style="swimlane;startSize=30;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="780" height="550" as="geometry"/>
        </mxCell>
        <mxCell id="webui" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Analyst console (Demo role)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="20" y="48" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="case" value="&lt;b&gt;Case service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Playbook approval, freezes, outreach&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="20" y="180" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="inteldb" value="&lt;b&gt;intel-db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Playbooks: pending, approved&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="300" y="180" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="intel" value="&lt;b&gt;Intelligence job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cloud Run Job: alerts to structured playbooks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="570" y="180" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="refdb" value="&lt;b&gt;ref-db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Watchlist snapshot, read by Scoring&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="300" y="310" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="loader" value="&lt;b&gt;Watchlist loader&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cloud Run Job, no LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="570" y="310" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sim" value="&lt;b&gt;Simulation job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cloud Run Job, synthetic only: role-play and evaluation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="20" y="440" width="190" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="core" value="&lt;b&gt;Core banking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Mock API, synthetic data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="300" y="443" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ext" value="Outside the bank" style="swimlane;startSize=30;html=1;fillColor=#fff8ef;strokeColor=#d79b00;fontSize=14;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="880" y="190" width="240" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="alerts" value="&lt;b&gt;Public scam alerts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;NPA, prefectural police, consumer centres&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="ext">
          <mxGeometry x="30" y="48" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gemini" value="&lt;b&gt;Gemini 2.5 Flash&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Vertex AI, schema-constrained&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="ext">
          <mxGeometry x="30" y="180" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lists" value="&lt;b&gt;Regulatory watchlists&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DICJ frozen accounts, FSA warnings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="ext">
          <mxGeometry x="30" y="310" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="No job has a case-db grant. The intelligence job writes only pending playbooks; an analyst approves them before the copilot can use them." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="750" width="1040" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="reviews, approves, decides" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="1" source="analyst" target="webui">
          <mxGeometry x="-0.45" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="approve, reject, freeze" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;" edge="1" parent="gcp" source="webui" target="case">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="approves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="gcp" source="case" target="inteldb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="gcp" source="intel" target="inteldb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="gcp" source="loader" target="refdb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="role-play turns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="gcp" source="sim" target="case">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="seeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="gcp" source="sim" target="core">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="fetches (untrusted)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="intel" target="alerts">
          <mxGeometry relative="1" as="geometry"/>
