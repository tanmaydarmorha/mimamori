<mxfile host="drawio"><diagram id="c4-containers-counter" name="c4-containers-counter"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0" value="&lt;b&gt;Container diagram for Mimamori: counter path&lt;/b&gt; (as built)" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="1000" height="36" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Mimamori&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=1;fontSize=14;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;absoluteArcSize=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="900" height="690" as="geometry"/></mxCell><mxCell id="customer" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;At the counter&lt;/font&gt;" style="html=1;fontSize=13;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="190" height="160" as="geometry"/></mxCell><mxCell id="teller" value="&lt;b&gt;Branch teller&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Decides every pause&lt;/font&gt;" style="html=1;fontSize=13;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="420" y="20" width="190" height="160" as="geometry"/></mxCell><mxCell id="webui" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;[Container: React SPA behind nginx]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Teller console. The only public service; proxies /api/* to the internal containers&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="840" height="90" as="geometry"/></mxCell><mxCell id="case" value="&lt;b&gt;Case service&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI, ADK]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Copilot, investigation agent, quote checks, risk-v1&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="220" height="110" as="geometry"/></mxCell><mxCell id="scoring" value="&lt;b&gt;Scoring&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Baselines, counterpart graph, watchlist. No LLM&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="220" height="110" as="geometry"/></mxCell><mxCell id="refdb" value="&lt;b&gt;ref-db&lt;/b&gt;&lt;br&gt;[Container: Firestore]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Watchlist snapshot&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="770" width="220" height="110" as="geometry"/></mxCell><mxCell id="casedb" value="&lt;b&gt;case-db&lt;/b&gt;&lt;br&gt;[Container: Firestore]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Baselines, cases, evidence cards, audit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="770" width="220" height="110" as="geometry"/></mxCell><mxCell id="inteldb" value="&lt;b&gt;intel-db&lt;/b&gt;&lt;br&gt;[Container: Firestore]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Approved playbooks&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="950" y="770" width="220" height="110" as="geometry"/></mxCell><mxCell id="core" value="&lt;b&gt;Core banking&lt;/b&gt;&lt;br&gt;[Software System, external]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Accounts and transfers (a mock in the prototype)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="220" height="110" as="geometry"/></mxCell><mxCell id="stt" value="&lt;b&gt;Speech-to-Text&lt;/b&gt;&lt;br&gt;[Software System, external]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Planned: today the teller types the turns&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;dashed=1;fillColor=#ffffff;strokeColor=#8C8496;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1310" y="250" width="220" height="110" as="geometry"/></mxCell><mxCell id="gemini" value="&lt;b&gt;Gemini 2.5 Flash&lt;/b&gt;&lt;br&gt;[Software System, external]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Vertex AI, schema-constrained. Never sees customer records&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1310" y="430" width="220" height="110" as="geometry"/></mxCell><mxCell id="r13" value="&lt;b&gt;Explains the transfer&lt;/b&gt;&lt;br&gt;[In person]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="customer" target="teller"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r14" value="&lt;b&gt;Types turns, decides&lt;/b&gt;&lt;br&gt;[HTTPS]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.218;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="teller" target="webui"><mxGeometry x="-0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r15" value="&lt;b&gt;Keys the transfer&lt;/b&gt;&lt;br&gt;[HTTPS, via proxy]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="webui" target="core"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="305"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r16" value="&lt;b&gt;Sends turns and decisions&lt;/b&gt;&lt;br&gt;[HTTPS; card updates over SSE]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.845;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="webui" target="case"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r17" value="&lt;b&gt;Requests a pre-transaction check&lt;/b&gt;&lt;br&gt;[REST, fail-open]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="core" target="scoring"><mxGeometry x="0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="507"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r18" value="&lt;b&gt;Opens a case&lt;/b&gt;&lt;br&gt;[REST]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="scoring" target="case"><mxGeometry x="-0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="655"/><mxPoint x="820" y="518"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r19" value="&lt;b&gt;Places holds and freezes&lt;/b&gt;&lt;br&gt;[REST]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="case" target="core"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r20" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;[Firestore]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="scoring" target="refdb"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r21" value="&lt;b&gt;Reads baselines&lt;/b&gt;&lt;br&gt;[Firestore]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="scoring" target="casedb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="693.5"/><mxPoint x="600" y="803"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r22" value="&lt;b&gt;Reads and writes cases&lt;/b&gt;&lt;br&gt;[Firestore]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="case" target="casedb"><mxGeometry x="-0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="924" y="825"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r23" value="&lt;b&gt;Reads approved playbooks&lt;/b&gt;&lt;br&gt;[Firestore]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="case" target="inteldb"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r24" value="&lt;b&gt;Runs copilot and agent&lt;/b&gt;&lt;br&gt;[Vertex AI]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="case" target="gemini"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r25" value="&lt;b&gt;Streams audio&lt;/b&gt;&lt;br&gt;[WebSocket, planned]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="webui" target="stt"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="t26" value="Dark blue: person · Grey: external person or system · Light blue: Mimamori container · Dashed box: planned, not built · Only Scoring and the case service can use case-db (per-database IAM)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="1300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>