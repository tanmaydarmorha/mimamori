        </mxCell>
        <mxCell id="case" value="&lt;b&gt;Case service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;FastAPI + ADK: copilot, investigation agent, quote checks, risk-v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
