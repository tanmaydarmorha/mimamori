<mxfile host="drawio"><diagram id="c4-containers-call" name="c4-containers-call"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0" value="&lt;b&gt;Container diagram for Mimamori: family call&lt;/b&gt; (as built)" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="1000" height="36" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Mimamori&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=1;fontSize=14;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;absoluteArcSize=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="900" height="560" as="geometry"/></mxCell><mxCell id="contact" value="&lt;b&gt;Trusted contact&lt;/b&gt;&lt;br&gt;[Person, external]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Family member named in advance&lt;/font&gt;" style="html=1;fontSize=13;whiteSpace=wrap;fillColor=#6C6477;strokeColor=#4D4D4D;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="190" height="160" as="geometry"/></mxCell><mxCell id="teller" value="&lt;b&gt;Branch teller&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Starts the call, sees the outcome&lt;/font&gt;" style="html=1;fontSize=13;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;verticalAlign=bottom;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="190" height="160" as="geometry"/></mxCell><mxCell id="webui" value="&lt;b&gt;Web UI&lt;/b&gt;&lt;br&gt;[Container: React SPA behind nginx]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Simulated phone and teller console. Stands in for real telephony&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="840" height="90" as="geometry"/></mxCell><mxCell id="case" value="&lt;b&gt;Case service&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Builds the filtered brief in code, issues the case code&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="220" height="110" as="geometry"/></mxCell><mxCell id="conv" value="&lt;b&gt;Conversation service&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Notice, callback check (number and case code), intent to approved templates. No case-db grant&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="650" y="430" width="220" height="130" as="geometry"/></mxCell><mxCell id="casedb" value="&lt;b&gt;case-db&lt;/b&gt;&lt;br&gt;[Container: Firestore]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cases, advance wishes, audit&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="50" y="630" width="220" height="110" as="geometry"/></mxCell><mxCell id="gemini" value="&lt;b&gt;Gemini 2.5 Flash&lt;/b&gt;&lt;br&gt;[Software System, external]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Vertex AI: what the caller asks (intent only)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1060" y="280" width="220" height="110" as="geometry"/></mxCell><mxCell id="tts" value="&lt;b&gt;Cloud Text-to-Speech&lt;/b&gt;&lt;br&gt;[Software System, external]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Chirp 3 HD, Japanese and English&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="220" height="110" as="geometry"/></mxCell><mxCell id="stt" value="&lt;b&gt;Speech-to-Text&lt;/b&gt;&lt;br&gt;[Software System, external]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Planned: the caller types today&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=10;dashed=1;fillColor=#ffffff;strokeColor=#8C8496;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1060" y="600" width="220" height="110" as="geometry"/></mxCell><mxCell id="r11" value="&lt;b&gt;Gets the notice, calls back&lt;/b&gt;&lt;br&gt;[Simulated phone]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.137;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="contact" target="webui"><mxGeometry x="-0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r12" value="&lt;b&gt;Starts the call, sees outcome&lt;/b&gt;&lt;br&gt;[HTTPS]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.786;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="teller" target="webui"><mxGeometry x="-0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r13" value="&lt;b&gt;Requests the contact call&lt;/b&gt;&lt;br&gt;[HTTPS]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.137;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="webui" target="case"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r14" value="&lt;b&gt;Fetches notices, carries the call&lt;/b&gt;&lt;br&gt;[HTTPS, WebSocket]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.857;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="webui" target="conv"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r15" value="&lt;b&gt;Sends filtered brief and case code&lt;/b&gt;&lt;br&gt;[REST]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.346;entryDx=0;entryDy=0;" edge="1" parent="1" source="case" target="conv"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r16" value="&lt;b&gt;Returns contact_view or verification_failed&lt;/b&gt;&lt;br&gt;[REST]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.731;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="case"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r17" value="&lt;b&gt;Reads and writes&lt;/b&gt;&lt;br&gt;[Firestore]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="case" target="casedb"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r18" value="&lt;b&gt;Classifies intent&lt;/b&gt;&lt;br&gt;[Vertex AI]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="gemini"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="449.5"/><mxPoint x="980" y="335"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r19" value="&lt;b&gt;Speaks approved wording&lt;/b&gt;&lt;br&gt;[TTS API]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.423;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="tts"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="r20" value="&lt;b&gt;Transcribes the caller&lt;/b&gt;&lt;br&gt;[Planned]" style="html=1;fontSize=11;fontColor=#404040;endArrow=blockThin;endFill=1;endSize=12;strokeColor=#828282;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="stt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="540.5"/><mxPoint x="980" y="655"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="t21" value="Dark blue: person · Grey: external person or system · Light blue: Mimamori container · Dashed box: planned, not built · The family hears only approved wording; the amount is never disclosed" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="1300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>