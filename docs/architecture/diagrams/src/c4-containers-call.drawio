<mxfile host="drawio">
  <diagram id="call" name="Family call">
    <mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Mimamori containers: family call (as built)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="700" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="contact" value="&lt;b&gt;Trusted contact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Family member the customer named in advance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="teller" value="&lt;b&gt;Branch teller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Starts the call, sees the outcome&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="550" y="60" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gcp" value="Mimamori · bank Google Cloud project (asia-south1) · Cloud Run" style="swimlane;startSize=30;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="760" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="webui" value="&lt;b&gt;Web UI&lt;/b&gt; · simulated phone and teller console&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Stands in for real telephony in the prototype&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="20" y="48" width="720" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="case" value="&lt;b&gt;Case service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Builds the filtered brief in code, issues the case code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="20" y="180" width="190" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="conv" value="&lt;b&gt;Conversation service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Notice, callback check (number + case code), intent to approved templates. No case-db grant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="530" y="180" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="casedb" value="&lt;b&gt;case-db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cases, wishes, audit&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="gcp">
          <mxGeometry x="30" y="320" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ext" value="Google Cloud AI" style="swimlane;startSize=30;html=1;fillColor=#fff8ef;strokeColor=#d79b00;fontSize=14;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="880" y="190" width="230" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="gemini" value="&lt;b&gt;Gemini 2.5 Flash&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Vertex AI: what the caller asks (intent only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="ext">
          <mxGeometry x="30" y="48" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tts" value="&lt;b&gt;Cloud Text-to-Speech&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Chirp 3 HD, Japanese and English&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="ext">
          <mxGeometry x="30" y="190" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="stt" value="&lt;b&gt;Speech-to-Text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Planned: the caller types today&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;fontSize=14;" vertex="1" parent="ext">
          <mxGeometry x="30" y="320" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Solid: built · Dashed: planned · The family hears only approved wording; the amount is never disclosed" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="1000" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="gets the notice, calls back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;entryX=0.132;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="contact" target="webui">
          <mxGeometry x="-0.45" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="starts the call, sees outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;entryX=0.840;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="teller" target="webui">
          <mxGeometry x="-0.45" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="contact call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=0.132;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="gcp" source="webui" target="case">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="notices, phone (WebSocket)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;startArrow=classic;exitX=0.854;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="gcp" source="webui" target="conv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="filtered brief, case code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.258;entryDx=0;entryDy=0;" edge="1" parent="gcp" source="case" target="conv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="contact_view or verification_failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=0;exitY=0.688;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="gcp" source="conv" target="case">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="reads, writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="gcp" source="case" target="casedb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="intent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="gemini">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="speech" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="tts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="planned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=1;exitY=0.95;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="stt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
