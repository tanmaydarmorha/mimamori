# Rendered by the nginx image's envsubst at start-up (only variables set in the environment are
# replaced; nginx's own $variables are left alone). Service URLs have no trailing slash.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# Rate limits on writes (the calls that can reach a model): per client and in total, so a public link
# can't run up the bill. Reads, SSE and page loads are never limited. Cloud Run puts the client first in
# X-Forwarded-For; the total cap still holds if someone fakes that header.
map $http_x_forwarded_for $client_ip {
    "~^(?<xff_first>[^,\s]+)" $xff_first;
    default                    $remote_addr;
}
map $request_method $write_by_ip {
    default "";
    POST    $client_ip;
    PUT     $client_ip;
    PATCH   $client_ip;
    DELETE  $client_ip;
}
map $request_method $write_all {
    default "";
    POST    all;
    PUT     all;
    PATCH   all;
    DELETE  all;
}
limit_req_zone $write_by_ip zone=writes_ip:10m rate=30r/m;
limit_req_zone $write_all   zone=writes_all:1m rate=60r/m;

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        default_type application/json;
        add_header Cache-Control no-store;
        return 200 '{"status":"ok","service":"web-ui","version":"0.1.0"}';
    }

    # Runtime config for the SPA (no rebuild per environment).
    location = /config.json {
        default_type application/json;
        add_header Cache-Control no-store;
        return 200 '{"env":"${MIMAMORI_ENV}","speech":"${MIMAMORI_SPEECH}"}';
    }

    # Who IAP says the caller is. Empty locally, so the SPA shows its role switcher.
    location = /whoami {
        default_type application/json;
        add_header Cache-Control no-store;
        return 200 '{"role":"$http_x_mimamori_role","user":"$http_x_mimamori_user"}';
    }

    # The browser only talks to this server; /api/<svc>/x -> ${...}/x. Works for plain HTTP,
    # SSE (buffering off) and WebSocket (Upgrade passed through).
    location /api/core/         { proxy_pass ${CORE_BANK_URL}/;            include /etc/nginx/mimamori-proxy.conf; }
    location /api/scoring/      { proxy_pass ${SCORING_URL}/;              include /etc/nginx/mimamori-proxy.conf; }
    location /api/case/         { proxy_pass ${CASE_SVC_URL}/;             include /etc/nginx/mimamori-proxy.conf; }
    location /api/conversation/ { proxy_pass ${CONVERSATION_SVC_URL}/;     include /etc/nginx/mimamori-proxy.conf; }

    # The services' error shape, so the console shows a readable message instead of nginx's HTML page.
    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"error":"rate_limited","detail":"Too many requests from this browser. Please wait a minute and try again."}';
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control no-cache;
        try_files $uri /index.html;
    }
}
